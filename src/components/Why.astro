---
import { site } from "../data/site";
import Points from "./Points.astro";
---

<section class="section why" aria-labelledby="why-title">
  <div class="wrap">
    <div class="why-head">
      <div>
        <h2 id="why-title" class="display">왜 바스피플일까요?</h2>
        <p class="lede">
          자격과 현장 경험, 남겨 온 기록으로 일합니다. 집에 들어오는 시공팀의 기준을 먼저 적어 둡니다.
        </p>
        <a class="text-link" href="/about">
          바스피플 만나보기<span aria-hidden="true">→</span>
        </a>
      </div>
      <figure class="why-photo">
        <img
          src={site.image}
          alt=""
          width={site.imageWidth}
          height={site.imageHeight}
        />
      </figure>
    </div>
    <Points />
  </div>
</section>

<style>
  .why-head {
    display: grid;
    gap: 28px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .why-photo {
    min-height: 280px;
    overflow: hidden;
    background: #cfc8bb;
  }

  .why-photo img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    object-position: center center;
  }

  @media (min-width: 900px) {
    .why-head {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: end;
    }

    .why-photo,
    .why-photo img {
      min-height: 420px;
    }
  }
</style>
