---
import { slides } from "../data/site";
---

<section class="hero" data-hero aria-roledescription="carousel" aria-label="바스피플 주요 소개">
  <div class="hero-stage">
    {
      slides.map((slide, index) => (
        <div class:list={["slide", { "is-active": index === 0 }]} data-slide aria-hidden={index !== 0}>
          <img
            src={slide.image}
            alt=""
            width={slide.width}
            height={slide.height}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-bottom">
    <div class="hero-copy">
      <div class="copy-stack">
        {
          slides.map((slide, index) => (
            <div class:list={["copy", { "is-active": index === 0 }]} data-copy aria-hidden={index !== 0}>
              <p class="eyebrow" data-eyebrow>
                {slide.eyebrow}
              </p>
              {index === 0 ? (
                <h1 class="hero-title">
                  {slide.title.map((line) => (
                    <span>{line}</span>
                  ))}
                </h1>
              ) : (
                <p class="hero-title">
                  {slide.title.map((line) => (
                    <span>{line}</span>
                  ))}
                </p>
              )}
            </div>
          ))
        }
      </div>
      <div class="actions">
        <a class="btn btn-light" href="/about">
          바스피플 만나보기<span aria-hidden="true">→</span>
        </a>
        <a class="btn btn-light" href="/quote">
          견적문의<span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="hero-controls">
      <p class="hero-count">
        <span data-current>1</span>
        <span aria-hidden="true"> / </span>
        <span>{slides.length}</span>
      </p>
      <div class="hero-buttons">
        <button type="button" data-prev aria-label="이전 사진">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M14.5 6 8.5 12l6 6" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </button>
        <button type="button" data-pause aria-pressed="false" aria-label="자동 넘김 일시정지">
          <svg data-icon-pause viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M8 6v12M16 6v12" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
          <svg data-icon-play viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" hidden>
            <path d="M9 7.2v9.6L17.2 12 9 7.2Z" fill="currentColor"></path>
          </svg>
        </button>
        <button type="button" data-next aria-label="다음 사진">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="m9.5 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="hero-progress" aria-hidden="true"><span data-bar></span></div>
  <p class="sr-only" aria-live="polite" data-live></p>
</section>

<script>
  const root = document.querySelector("[data-hero]");
  if (root instanceof HTMLElement && root.dataset.bound !== "true") {
    root.dataset.bound = "true";

    const slides = [...root.querySelectorAll("[data-slide]")];
    const copies = [...root.querySelectorAll("[data-copy]")];
    const current = root.querySelector("[data-current]");
    const live = root.querySelector("[data-live]");
    const bar = root.querySelector("[data-bar]");
    const pauseBtn = root.querySelector("[data-pause]");
    const pauseIcon = root.querySelector("[data-icon-pause]");
    const playIcon = root.querySelector("[data-icon-play]");
    const total = slides.length;
    let index = 0;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let onEnd = null;

    const syncPause = () => {
      const paused = root.classList.contains("is-paused");
      if (pauseBtn instanceof HTMLButtonElement) {
        pauseBtn.setAttribute("aria-pressed", String(paused));
        pauseBtn.setAttribute("aria-label", paused ? "자동 넘김 재생" : "자동 넘김 일시정지");
      }
      if (pauseIcon instanceof SVGElement) pauseIcon.hidden = paused;
      if (playIcon instanceof SVGElement) playIcon.hidden = !paused;
    };

    const restart = () => {
      if (!(bar instanceof HTMLElement)) return;
      if (onEnd) {
        bar.removeEventListener("animationend", onEnd);
        onEnd = null;
      }
      bar.classList.remove("is-run");
      void bar.offsetWidth;
      if (root.classList.contains("is-paused")) return;
      bar.classList.add("is-run");
      onEnd = (event) => {
        if (event.target !== bar) return;
        bar.removeEventListener("animationend", onEnd);
        onEnd = null;
        if (root.classList.contains("is-paused") || root.classList.contains("is-paused-by-hide")) return;
        render(index + 1, true);
      };
      bar.addEventListener("animationend", onEnd);
    };

    const render = (next, announce) => {
      index = (next + total) % total;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === index;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });
      copies.forEach((copy, copyIndex) => {
        const active = copyIndex === index;
        copy.classList.toggle("is-active", active);
        copy.setAttribute("aria-hidden", active ? "false" : "true");
      });
      if (current) current.textContent = String(index + 1);
      if (announce && live) {
        const eyebrow = copies[index]?.querySelector("[data-eyebrow]")?.textContent?.trim() ?? "";
        live.textContent = `${index + 1} / ${total}. ${eyebrow}`;
      }
      restart();
    };

    root.querySelector("[data-prev]")?.addEventListener("click", () => render(index - 1, true));
    root.querySelector("[data-next]")?.addEventListener("click", () => render(index + 1, true));
    pauseBtn?.addEventListener("click", () => {
      root.classList.toggle("is-paused");
      syncPause();
      if (!root.classList.contains("is-paused")) restart();
    });

    document.addEventListener("visibilitychange", () => {
      root.classList.toggle("is-paused-by-hide", document.hidden);
    });

    if (reduce) root.classList.add("is-paused");
    syncPause();
    if (!reduce) restart();
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    background: var(--night);
    color: var(--white);
    overflow: hidden;
  }

  .hero-stage,
  .slide,
  .hero-shade {
    position: absolute;
    inset: 0;
  }

  .slide {
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .slide.is-active {
    opacity: 1;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .hero-shade {
    background:
      linear-gradient(90deg, rgba(8, 9, 8, 0.47) 0%, rgba(8, 9, 8, 0.18) 46%, rgba(8, 9, 8, 0.12) 100%),
      linear-gradient(180deg, rgba(8, 9, 8, 0.27) 0%, rgba(8, 9, 8, 0.1) 36%, rgba(8, 9, 8, 0.55) 100%);
  }

  .hero-bottom {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 0 20px 36px;
  }

  .copy-stack {
    display: grid;
  }

  .copy {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 700ms ease;
  }

  .copy.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 500;
    color: rgba(246, 243, 236, 0.78);
  }

  .hero-title {
    margin-top: 12px;
    max-width: 11em;
    font-size: clamp(36px, 5.4vw, 80px);
    font-weight: 500;
    letter-spacing: -0.048em;
    line-height: 1.12;
  }

  .hero-title span {
    display: block;
  }

  .hero-controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hero-count {
    min-width: 52px;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .hero-buttons {
    display: flex;
    gap: 8px;
  }

  .hero-buttons button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(246, 243, 236, 0.5);
    background: transparent;
    color: inherit;
  }

  .hero-buttons button:hover {
    background: var(--white);
    color: var(--ink);
  }

  .hero-progress {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(246, 243, 236, 0.22);
  }

  .hero-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--brass-2);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .hero-progress span.is-run {
    animation: hero-load 6.5s linear forwards;
  }

  .hero.is-paused .hero-progress span.is-run,
  .hero.is-paused-by-hide .hero-progress span.is-run {
    animation-play-state: paused;
  }

  @keyframes hero-load {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (min-width: 960px) {
    .hero-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 40px;
      padding: 0 48px 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .copy {
      transition: none;
    }
  }
</style>
