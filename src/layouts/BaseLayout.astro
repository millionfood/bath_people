---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  solidHeader?: boolean;
  preloadImage?: string;
  noindex?: boolean;
}

const { title, description, solidHeader = false, preloadImage, noindex = false } = Astro.props;
const origin = site.url || Astro.site?.origin || "";
const pathname = Astro.url.pathname;
const canonical = origin ? new URL(pathname, origin).href : undefined;
const ogImage = origin ? new URL(site.image, origin).href : site.image;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="author" content="바스피플" />
    <meta name="theme-color" content="#10110f" />
    <meta name="geo.region" content="KR-48" />
    <meta name="geo.placename" content="양산시" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="naver-site-verification" content="cc5a313f866086c5900d94e6e13ed857d0ede0d9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Parisienne&display=swap"
    />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">본문으로 건너뛰기</a>
    <Header solid={solidHeader} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
