---
import { certificates } from "../data/site";
import Points from "./Points.astro";
---

<section class="section why" aria-labelledby="why-title">
  <div class="wrap">
    <div class="why-head">
      <div class="why-copy">
        <h2 id="why-title" class="display">왜 바스피플일까요?</h2>
        <p class="lede">
          바스피플은 자격과 현장 경험, 남겨 온 기록으로 일합니다.
          바스피플만의 강점을 소개합니다.
        </p>
        <a class="text-link" href="/about">
          바스피플 만나보기<span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="why-certs">
        {
          certificates.map((cert) => (
            <figure>
              <img
                src={cert.image}
                alt={cert.alt}
                width={cert.width}
                height={cert.height}
                decoding="async"
              />
              <figcaption>{cert.name}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
    <Points />
  </div>
</section>

<style>
  .why-head {
    display: grid;
    gap: 32px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .why-certs {
    display: grid;
    gap: 22px;
  }

  .why-certs figure {
    margin: 0;
  }

  .why-certs img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    background: var(--paper-light);
  }

  .why-certs figcaption {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--ink-soft);
  }

  @media (min-width: 720px) {
    .why-certs {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  @media (min-width: 1100px) {
    .why-head {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }

    .why-copy {
      display: grid;
      grid-template-columns: min-content;
    }

    .why-copy h2 {
      white-space: nowrap;
    }

    .why-copy .lede {
      max-width: 100%;
    }
  }
</style>
