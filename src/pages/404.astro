---
import Base from "../layouts/BaseLayout.astro";
---

<Base
  title="페이지를 찾지 못했습니다 | 바스피플"
  description="요청한 페이지가 없습니다. 바스피플 홈 또는 견적문의로 이동할 수 있습니다."
  solidHeader
>
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>페이지를 찾지 못했습니다.</h1>
      <p class="lede">주소가 바뀌었거나, 없는 페이지입니다.</p>
      <div class="actions">
        <a class="btn btn-solid" href="/">홈으로</a>
        <a class="btn" href="/quote">견적문의</a>
      </div>
    </div>
  </header>
</Base>
